# `pnpm dev:homelab`: local dev against the live homelab console (see vite.config.ts proxy).
# Mode files outrank .env.local, so these win over any older local settings. No secrets here:
# the console's Caddy adds API keys, and the app skips the Google sign-in when VITE_SAZED_URL is set.
VITE_SAZED_URL=/api
VITE_GATEWAY_URL=/gw
VITE_API_KEY=
